# Port the server listens on
PORT=3000
# Save projects in Redis. Leave empty to save JSON files in DATA_DIR instead.
REDIS_URL=
DATA_DIR=./data
# Optional: delete projects not saved for this many days (0 = keep forever)
PROJECT_TTL_DAYS=0
# Optional: ask for a login (browser shows a password prompt)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Optional: biggest project the server accepts
BODY_LIMIT=60mb
